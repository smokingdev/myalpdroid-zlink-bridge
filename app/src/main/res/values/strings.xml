    <string name="infer_playing">Show received tracks as playing when playback state is unavailable</string>
    <string name="auto_start">Start automatically when the head unit boots</string>
    <string name="auto_start_help">Press Start once to enable the bridge. Stop keeps it off until you start it again. Some head units also require allowing the app to run in the background.</string>
    <string name="setup">MYALPDROID SETUP</string>
    <string name="setup_help">Use ZLink normally after starting the bridge. Enable this app in MyAlpDroid’s player settings and allow MyAlpDroid notification access. Restart MyAlpDroid after installation. Navigation depends on the data supplied by the CarPlay app.</string>
    <string name="diagnostics">DIAGNOSTICS</string>
    <string name="diagnostics_help">Diagnostics include track and road names. Older entries are trimmed automatically at 2 MiB or 5,000 events so logging continues. Starting a new session resets the log.</string>
